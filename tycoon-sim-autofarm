-- SISTEMA DE INVISIBILIDADE (SEGURO E ATUALIZADO)
----------------------------------------------------
local function setInvisState(state)
    local char = player.Character
    if not char then return end
    
    if state then
        -- Torna partes locais transparentes sem quebrar juntas motoras fundamentais
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Decal") then
                if part.Name ~= "HumanoidRootPart" then
                    part.Transparency = 1
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end
    else
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.Health = 0 end -- Força respawn para resetar estado
    end
end

task.spawn(function()
    while task.wait(0.5) do
        if not ScreenGui or not ScreenGui.Parent then break end
        if getgenv().InvisibleMode then setInvisState(true) end
    end
end)

