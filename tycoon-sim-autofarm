-- SISTEMA DE INVISIBILIDADE (COMPATÍVEL COM TELEPORTE)
----------------------------------------------------
local savedParts = {}

local function setInvisState(state)
    local char = player.Character
    if not char then return end
    
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("Decal") then
            -- Ignora o HumanoidRootPart para você não cair do mapa
            if part.Name ~= "HumanoidRootPart" then
                if state then
                    -- Salva a transparência original se ainda não tiver salvo
                    if not savedParts[part] then
                        savedParts[part] = part.Transparency
                    end
                    part.Transparency = 1 -- Fica invisível
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                else
                    -- Restaura se for desativado
                    if savedParts[part] then
                        part.Transparency = savedParts[part]
                        if part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Torso" then
                            part.CanCollide = true
                        end
                    end
                end
            end
        end
    end
end

-- Mantém invisível mesmo se o boneco renascer ou atualizar as roupas
task.spawn(function()
    while ScreenGui and ScreenGui.Parent do
        if getgenv().InvisibleMode then
            setInvisState(true)
        end
        task.wait(0.5)
    end
end)

----------------------------------------------------
-- MECÂNICA DE COLETA (CRISTAIS & CRATES)
----------------------------------------------------
local function collectItem(object)
    if not getgenv().AutoCollectCrystals then return end
    local character = player.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local targetPart = object:IsA("BasePart") and object or object:FindFirstChildWhichIsA("BasePart")
    
    if rootPart and targetPart then
        rootPart.CFrame = targetPart.CFrame
        getgenv().ItemsCollected = getgenv().ItemsCollected + 1
        CounterLabel.Text = "Coletados: " .. tostring(getgenv().ItemsCollected)
        task.wait(0.3)
    end
end

-- Loop de Varredura Otimizado
task.spawn(function()
    while ScreenGui and ScreenGui.Parent do
        if getgenv().AutoCollectCrystals then
            for _, child in ipairs(workspace:GetChildren()) do
                -- Ignora pastas pesadas de construções e esteiras
                if child.Name ~= "Tycoons" and child.Name ~= "Environments" then
                    local nameLower = child.Name:lower()
                    -- Filtro detecta variações de Crystal (cristais) e Crate / Gift / Box (caixas de evento)
                    if string.find(nameLower, "crystal") or string.find(nameLower, "cristal") or string.find(nameLower, "crate") or string.find(nameLower, "box") then
                        collectItem(child)
                    elseif child:IsA("Model") and (string.find(nameLower, "crystal") or string.find(nameLower, "cristal") or string.find(nameLower, "crate") or string.find(nameLower, "box")) then
                        collectItem(child)
                    end
                end
            end
        end
        task.wait(2)
    end
end)

