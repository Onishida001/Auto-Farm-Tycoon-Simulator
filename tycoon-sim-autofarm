-- FUNCIONALIDADE DE INVISIBILIDADE LOCAL
----------------------------------------------------
local function setInvisState(state)
    local char = player.Character
    if not char then return end
    
    if state then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Decal") then
                if part.Name ~= "HumanoidRootPart" then
                    part.Transparency = 1
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end
    else
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.Health = 0 end 
    end
end

task.spawn(function()
    while task.wait(0.5) do
        if not ScreenGui or not ScreenGui.Parent then break end
        if getgenv().InvisibleMode then setInvisState(true) end
    end
end)

----------------------------------------------------
-- COLETOR INTELIGENTE RECURSIVO
----------------------------------------------------
local function isTargetItem(object)
    local nameLower = object.Name:lower()
    return string.find(nameLower, "crystal") or string.find(nameLower, "cristal") or 
           string.find(nameLower, "crate") or string.find(nameLower, "box") or 
           string.find(nameLower, "gift")
end

task.spawn(function()
    while task.wait(1) do
        if not ScreenGui or not ScreenGui.Parent then break end
        if getgenv().AutoCollectCrystals then
            for _, child in ipairs(Workspace:GetDescendants()) do
                if not getgenv().AutoCollectCrystals then break end
                
                if isTargetItem(child) then
                    local character = player.Character
                    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                    local targetPart = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
                    
                    if rootPart and targetPart and targetPart:IsDescendantOf(Workspace) then
                        rootPart.CFrame = targetPart.CFrame
                        getgenv().ItemsCollected = getgenv().ItemsCollected + 1
                        CounterLabel.Text = "Coletados: " .. tostring(getgenv().ItemsCollected)
                        task.wait(0.4) -- Delay adaptado para evitar kick por movimentação no Xeno
                    end
                end
            end
        end
    end
end)

